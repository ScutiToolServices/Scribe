# Copy to .env (git-ignored). run.bat loads it for a local run (--dotenv, names only are printed); Docker compose reads it from this folder; a real environment variable wins.
# Start-up values only. Model, limits and live-dictation options are settings: change them on the admin page (/admin/);
# a saved value beats .env. If you use a model service, the Whisper model setting must match the model it runs.
# Shared with armory and ember_api. Leave empty only for loopback-only use.
INTERNAL_API_TOKEN=
SCRIBE_HOST=127.0.0.1
SCRIBE_PORT=8091
# Docker only: 0.0.0.0 = reachable on the LAN (Zima dashboard link); 127.0.0.1 = this machine only.
SCRIBE_BIND=0.0.0.0
# Unlocks /admin/ (settings, saved model connections, usage). Empty = page off.
SCRIBE_ADMIN_PASSWORD=
# The model service address and token are not set here: save a connection on the admin page (/admin/).
