# Copy to .env (git-ignored). run.bat loads it (--dotenv); Docker compose reads it; a real environment variable wins.
# Start-up values only; limits are admin-page settings and a saved value beats .env. Model connections: save them on /admin/.

SERVICE_HOST=127.0.0.1
SERVICE_PORT=29401
# Docker only: 0.0.0.0 = LAN, 127.0.0.1 = this machine
SERVICE_BIND=0.0.0.0
# Empty = no page and no token checks (loopback only). Required when HOST is not loopback.
SERVICE_ADMIN_PASSWORD=
